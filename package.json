{
  "name": "central-de-avisos-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "node scripts/dev-local.mjs",
    "dev:interface": "node scripts/run-framework.mjs dev",
    "resolver": "node scripts/hostname-resolver.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --experimental-strip-types --test tests/auth-account.test.mjs tests/network.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "undici": "7.30.1",
    "fflate": "0.8.3"
  }
}
