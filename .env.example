# Endereço do servidor atual da Intranet, sem barra no final.
INTRANET_BASE_URL=https://intranet.exemplo.gov.br

# Token opcional. Ele fica somente no servidor web e nunca é enviado ao navegador.
INTRANET_AVISOS_TOKEN=

# Serviço auxiliar local que resolve IPs privados em nomes de máquinas.
HOSTNAME_RESOLVER_URL=http://127.0.0.1:5190/resolve

# Active Directory institucional. Use valores reais somente no .env.local.
CENTRAL_AD_URL=ldaps://dc01.exemplo.local:636
CENTRAL_AD_DOMAIN=exemplo.local
CENTRAL_AD_BASE_DN=DC=exemplo,DC=local
CENTRAL_AD_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={0}))
CENTRAL_AD_ALLOWED_GROUPS=CENTRAL_AVISOS_ADMIN,CENTRAL_AVISOS_OPERADOR
CENTRAL_AD_ALLOW_INSECURE_LDAP=false
CENTRAL_AD_TLS_REJECT_UNAUTHORIZED=true

# Gere um valor aleatório com pelo menos 32 caracteres; não compartilhe entre ambientes.
CENTRAL_AUTH_SECRET=
